# Copy this file to .env and fill in the values for your environment.
# In development the Vite proxy (vite.config.js) forwards /api → http://localhost:9090,
# so VITE_API_BASE_URL can stay empty.
# In production set it to the full backend base URL (no trailing slash).

VITE_API_BASE_URL=

# Full backend URL for absolute links (connector token URLs, etc.), WITHOUT the
# "/api" suffix — connector routes live at the backend root (/connector/**), not under /api.
# Normally left empty: it's derived at runtime from the hostname (see resolveBackendUrl in
# src/services/api.js) — localhost → http://localhost:9090, any other host → https://api.<host>.
# Only set this to override that derivation (e.g. non-standard deployment topology).
VITE_BACKEND_URL=
