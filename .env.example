# Copy this file to .env and fill in the values for your environment.
# In development the Vite proxy (vite.config.js) forwards /api → http://localhost:9090,
# so VITE_API_BASE_URL can stay empty.
# In production set it to the full backend base URL (no trailing slash).

VITE_API_BASE_URL=

# Full backend URL for absolute links (connector token URLs, etc.).
# In dev: http://localhost:9090/api — In prod: https://api.andromeda.ia.br/api
VITE_BACKEND_URL=http://localhost:9090/api
